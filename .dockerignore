# Python
__pycache__/
*.pyc
.venv/
venv/

# 密钥 / 环境变量：构建时不烤进镜像，运行时用 -v 或 compose 挂载
.env
.env.*
*.key

# WorkBuddy 私有记忆（不进镜像）
.workbuddy/

# 本地 agent 数据库
memory/chat_history.db
memory/*.db

# Git
.git/
.gitignore

# 前端依赖（构建时重新安装，不烤进镜像）
node_modules/
frontend/node_modules/
frontend/dist/         # 多阶段构建中重新生成

# 误生成产物 / 系统文件
nul
.DS_Store
Thumbs.db
